{
	"schemaVersion": 1,
	"id": "sculksight",
	"version": "${version}",
	"name": "Sculk Sight",
	"description": "Renders the effective detection surface of sculk sensors as a world overlay.",
	"authors": [
		"scr0ols"
	],
	"contact": {
		"homepage": "https://github.com/scr0ols/Sculk-Sight",
		"sources": "https://github.com/scr0ols/Sculk-Sight",
        "issues": "https://github.com/scr0ols/Sculk-Sight/issues",
        "modrinth": "https://www.youtube.com/watch?v=YkADj0TPrJA&list=RDYkADj0TPrJA&start_radio=1",
        "curseforge": "https://www.youtube.com/watch?v=YkADj0TPrJA&list=RDYkADj0TPrJA&start_radio=1"
    },
	"icon": {
		"16": "assets/sculksight/icon_16.png",
		"32": "assets/sculksight/icon_32.png",
		"64": "assets/sculksight/icon_64.png",
		"128": "assets/sculksight/icon_128.png",
		"256": "assets/sculksight/icon_256.png",
		"512": "assets/sculksight/icon_512.png"
	},
	"license": "GPL-3.0-or-later",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.scr0ols.sculksight.client.SculkSightClient"
		]
	},
	"mixins": [
		{
			"config": "sculksight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
